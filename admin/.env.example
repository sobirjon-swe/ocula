# API manzili. Dev'da nisbiy yo'l qoldiriladi — Vite `/api` ni
# `VITE_BACKEND_URL` ga uzatadi (vite.config.ts), CORS kerak bo'lmaydi.
VITE_API_URL=/api/v1

# Vite dev-proxy qaysi backendga ursin.
VITE_BACKEND_URL=http://localhost:8000

# Prodda: VITE_API_URL=https://api.optika.uz/api/v1 (proxy ishlatilmaydi).
# O'shanda backendda CORS sozlanishi kerak — `config/cors.php` hali chop
# etilmagan, Laravel'ning sukutdagi ruxsati amal qiladi.
