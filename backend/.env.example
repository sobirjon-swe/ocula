APP_NAME=Optika
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Bazada hamma vaqt UTC (PROJECT.md §2). Frontend Asia/Tashkent ga o'giradi.
APP_TIMEZONE=UTC

APP_LOCALE=uz-latn
APP_FALLBACK_LOCALE=uz-latn
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL 16+ majburiy (§15 #20) — pg_trgm va unaccent kengaytmalari bilan.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=optika
DB_USERNAME=postgres
DB_PASSWORD=

# Windows dev mashinasida Redis yo'q — database drayveri ishlatiladi (§15 #21).
# Prodda: CACHE_STORE=redis, QUEUE_CONNECTION=redis, SESSION_DRIVER=redis + Horizon.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Sanctum SPA cookie auth — admin panel Vite dev serveri (§15 #15).
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@optika.uz"
MAIL_FROM_NAME="${APP_NAME}"

OPTIKA_MONEY_ROUNDING_STEP=100
OPTIKA_MIN_PREPAYMENT_PERCENT=0