includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
        - tests/

    level: 7

    # Laravel'ning `Seeder::$command` PHPDoc'i `Command` deb yozilgan, ammo
    # seeder artisan'siz ishga tushirilganda u `null` bo'ladi. Vendor
    # PHPDoc'lariga so'zsiz ishonmaymiz.
    treatPhpDocTypesAsCertain: false
