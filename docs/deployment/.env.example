# Docker Compose interpolation only. Copy to .env; do not commit the real file.
POSTGRES_DB=optika
PG_ADMIN_PASSWORD=replace-with-separate-random-admin-password
DB_PASSWORD=replace-with-long-random-database-password
REDIS_PASSWORD=replace-with-long-random-redis-password
PUBLIC_HOST=optika.example.com
ADMIN_HOST=admin.optika.example.com
CUSTOMER_HOST=customer.optika.example.com
SITE_URL=https://optika.example.com
# Optional preferred QR target: https://t.me/your_bot/app
TELEGRAM_MINI_APP_URL=
# Public browser key, restricted to the actual employee hostname by the provider.
# Rebuild web after changing it. Never place a server-side secret here.
VITE_YANDEX_MAPS_KEY=
# Bind to loopback behind a TLS reverse proxy. Do not expose plain HTTP publicly.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
