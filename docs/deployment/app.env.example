# Copy to .env.app (ignored). Backend runtime only; never used as a build argument.
APP_NAME=OPTIKA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://admin.optika.example.com
APP_TIMEZONE=UTC
APP_LOCALE=uz-latn
APP_FALLBACK_LOCALE=uz-latn
LOG_CHANNEL=stderr
LOG_LEVEL=warning
FRONTEND_URL=https://admin.optika.example.com
SANCTUM_STATEFUL_DOMAINS=admin.optika.example.com
SESSION_DOMAIN=admin.optika.example.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=true
SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@optika.example.com
MAIL_FROM_NAME=OPTIKA
OPTIKA_MONEY_ROUNDING_STEP=100
OPTIKA_MIN_PREPAYMENT_PERCENT=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_DIRECTOR_CHAT_ID=
# Optional PLAY MOBILE SMS-Broker HTTPS /send fallback; disabled until configured.
SMS_ENABLED=false
SMS_API_URL=
SMS_USERNAME=
SMS_PASSWORD=
SMS_ORIGINATOR=Optika
